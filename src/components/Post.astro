---
import type { CollectionEntry } from "astro:content";
import PreviewImage from "./PreviewImage.astro";

type Props = { post: CollectionEntry<"posts">; priority?: boolean };
const { post, priority = false } = Astro.props;

const dateLabel = post.data.date.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<article class="entry">
  <a class="entry__link" href={`/${post.data.permalink}`}>
    <PreviewImage
      image={post.data.preview}
      alt={post.data.alt ?? ""}
      priority={priority}
      width={960}
      sizes="(min-width: 1600px) 33vw, (min-width: 860px) 50vw, 100vw"
    />
    <div class="entry__text">
      <time class="entry__date" datetime={post.data.date.toISOString()}>{dateLabel}</time>
      <h3 class="entry__title">{post.data.title}</h3>
      <p class="entry__desc">{post.data.description}</p>
    </div>
  </a>
</article>

<style>
  .entry__link {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    color: inherit;
  }

  .entry__link :global(img) {
    aspect-ratio: 3 / 2;
  }

  .entry__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 46ch;
  }

  .entry__date {
    font-size: 14px;
    color: var(--soft);
  }

  .entry__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    color: var(--color-text);
    margin: 0;
  }

  .entry__desc {
    font-size: 17px;
    line-height: 1.5;
    color: var(--soft);
    margin: 0;
  }

  /* Hover / keyboard-focus feedback: the title underlines. No zoom. */
  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  @media (max-width: 859px) {
    .entry__title { font-size: 26px; }
  }
</style>

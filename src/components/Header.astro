---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { label: "Blog", href: "/blog" },
  { label: "About", href: "/about" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<header class="masthead comp">
  <a class="wordmark plane plane--k m3" href="/">donebysimon</a>
  <span class="plane plane--red m1 square" aria-hidden="true"></span>

  <nav class="mainnav" aria-label="Main">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  /* Outside <main>, so the header carries its own cap and centring. */
  .masthead {
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    grid-auto-rows: 72px;
    border-bottom: 2px solid var(--line);
  }

  .wordmark {
    grid-column: 1 / span 3;
    display: flex;
    align-items: center;
    padding-inline: 28px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    text-decoration: none;
  }
  .wordmark:any-link { color: var(--on-k); }

  .square { grid-column: 4 / span 1; }

  .mainnav {
    grid-column: 5 / span 8;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 36px;
    padding-inline: 28px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    text-transform: lowercase;
  }
  .mainnav ul {
    display: flex;
    gap: 36px;
  }
  .mainnav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .mainnav a:hover,
  .mainnav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  @media (max-width: 859px) {
    .wordmark, .square { min-height: 72px; }
    .mainnav {
      justify-content: flex-start;
      gap: 24px;
      padding: 14px 20px;
    }
    .mainnav ul { gap: 24px; }
  }
</style>

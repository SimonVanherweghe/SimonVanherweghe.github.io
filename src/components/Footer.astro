---
// `me` marks rel="me" identity links used for IndieAuth/Bridgy.
const links = [
  { label: "Instagram", href: "https://www.instagram.com/donebysimon/", external: true },
  { label: "GitHub", href: "https://github.com/simonvanherweghe", external: true, me: true },
  { label: "Bluesky", href: "https://bsky.app/profile/donebysimon.be", external: true, me: true },
  { label: "Mastodon", href: "https://mastodon.social/@donebysimon", external: true, me: true },
  { label: "RSS", href: "/feed.xml", external: false },
  { label: "The Archive", href: "/archive", external: false },
];
---

<footer class="colophon comp">
  <span class="colophon__word">donebysimon.be</span>
  <span class="plane plane--blue colophon__square" aria-hidden="true"></span>

  <nav class="colophon__nav" aria-label="Find Simon elsewhere">
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external
                ? {
                    target: "_blank",
                    rel: link.me
                      ? "me noopener noreferrer"
                      : "noopener noreferrer",
                  }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>

<style>
  /* Outside <main>, so the footer carries its own cap and centring. */
  .colophon {
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    grid-auto-rows: minmax(72px, auto);
    border-top: 2px solid var(--line);
    font-family: var(--font-display);
    font-size: 16px;
    text-transform: lowercase;
  }

  .colophon__word {
    grid-column: 1 / span 6;
    display: flex;
    align-items: center;
    padding-inline: 28px;
  }

  .colophon__square { grid-column: 7 / span 1; }

  .colophon__nav {
    grid-column: 8 / span 5;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-inline: 28px;
  }
  .colophon__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 24px;
  }
  .colophon__nav a {
    display: inline-block;
    /* padding-block grows the tap target to ~44px. */
    padding-block: 12px;
    text-decoration: none;
  }
  .colophon__nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  @media (max-width: 859px) {
    .colophon__word { min-height: 72px; padding-inline: 20px; }
    .colophon__square { display: none; }
    .colophon__nav { padding-inline: 20px; }
    .colophon__nav ul { justify-content: flex-start; }
  }
</style>

---
import type { CollectionEntry } from "astro:content";
import Post from "./Post.astro";

type Props = {
  posts: CollectionEntry<"posts">[];
  // Heading row text; null hides the row (pages that bring their own h1).
  heading?: string | null;
  // Total shown as "N projects"; the home gallery omits the hero post, so it passes the full count.
  count?: number;
};
const { posts, heading = "all work", count = posts.length } = Astro.props;
---

{
  heading !== null ? (
    <div class="list-head comp">
      <h2 class="list-head__title">{heading}</h2>
      <p class="list-head__count">{count} projects</p>
    </div>
  ) : (
    <h2 class="visually-hidden">Posts</h2>
  )
}
<ul class="post-list">
  {posts.map((post) => <li><Post post={post} /></li>)}
</ul>

<style>
  .list-head {
    grid-auto-rows: auto;
  }

  .list-head__title {
    grid-column: 1 / span 6;
    margin: 0;
    padding: 96px 28px 40px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 34px;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }

  .list-head__count {
    grid-column: 7 / span 6;
    margin: 0;
    padding: 96px 28px 40px;
    align-self: end;
    text-align: right;
    font-size: 15px;
    color: var(--soft);
  }

  /* Two calm columns, no rules; space does the separating. */
  .post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 88px 56px;
    padding: 0 1.75rem 128px;
  }

  @media (min-width: 1600px) {
    .post-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 64px;
    }
  }

  @media (max-width: 859px) {
    .list-head__count { display: none; }
    .list-head__title { padding: 72px 20px 32px; }
    .post-list {
      grid-template-columns: 1fr;
      row-gap: 56px;
      padding: 0 1.25rem 88px;
    }
  }
</style>

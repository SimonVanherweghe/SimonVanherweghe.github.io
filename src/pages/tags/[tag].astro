---
import PostsList from "../../components/PostsList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  posts.sort((a, b) => +b.data.date - +a.data.date);

  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag: tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout pageTitle={`Posts tagged with ${tag}`}>
  <h1>Posts tagged with <span>'{tag}'</span></h1>
  <PostsList posts={posts} heading={null} />
</BaseLayout>

<style>
  /* Outside .page so the gallery keeps the home width. The h1 takes the gallery's side
     padding to line up with the cards, and the gap below matches the list-head rhythm. */
  h1 {
    margin-bottom: 40px;
    padding-inline: 1.75rem;
  }

  @media (max-width: 859px) {
    h1 {
      margin-bottom: 32px;
      padding-inline: 1.25rem;
    }
  }

  span {
    font-family: var(--font-body);
    color: var(--ink);
  }
</style>
